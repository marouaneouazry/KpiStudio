# Variables d'environnement pour Mantis KPI Studio
# Copiez ce fichier en .env et adaptez les valeurs selon votre environnement IT.

# -----------------------------------------------------------------------------
# Chemins de l'application
# -----------------------------------------------------------------------------
# APP_CONFIG_DIR=
# APP_OUTPUT_DIR=

# -----------------------------------------------------------------------------
# Configuration Authentification JWT (MANDATORY IN PRODUCTION)
# -----------------------------------------------------------------------------
# Clé secrète pour la signature des jetons JWT (Obligatoire en production, ex: python -c "import secrets; print(secrets.token_urlsafe(64))")
JWT_SECRET=change_this_to_a_secure_random_secret_key_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Configuration Sécurité des Cookies (Secure=True, HttpOnly=True, SameSite=strict)
COOKIE_SECURE=True
COOKIE_SAMESITE=strict

# -----------------------------------------------------------------------------
# Configuration Serveur LDAP (Fournie par l'équipe IT)
# -----------------------------------------------------------------------------
# Adresse du serveur LDAP ou Active Directory (ex: ldap.company.local ou 10.0.0.50)
LDAP_SERVER=ldap.company.com

# Port LDAP (389 par défaut pour LDAP non SSL / TLS, 636 pour LDAPS)
LDAP_PORT=389

# Utiliser SSL/TLS (True / False)
LDAP_USE_SSL=False

# Base DN pour la recherche des utilisateurs
LDAP_BASE_DN=dc=company,dc=com

# DN du compte de service pour la recherche initiale (Laissez vide pour anonyme si autorisé)
LDAP_BIND_DN=cn=admin_kpi,ou=service_accounts,dc=company,dc=com

# Mot de passe du compte de service
LDAP_BIND_PASSWORD=placeholder_password

# Filtre de recherche LDAP
# Pour Active Directory : (sAMAccountName={username})
# Pour OpenLDAP / Generic LDAP : (uid={username}) ou (cn={username})
LDAP_SEARCH_FILTER=(sAMAccountName={username})

# Mode de test sans serveur LDAP réel (Activer avec True uniquement en dev si le serveur LDAP n'est pas joignable)
# ALLOW_MOCK_LDAP=False
